{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "T3 LAN home repair preview v1",
  "description": "Read-only metadata, UTF-8 JSON bounded to 131072 bytes. planId is not an execution authorization.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "operation": {
      "const": "preview"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": ["fresh", "original-only", "lan-only", "split", "blocked"]
    },
    "recommendedAction": {
      "enum": [
        "create-original",
        "adopt-original",
        "retain-lan",
        "adopt-original-retain-lan",
        "resolve-blockers"
      ]
    },
    "cancellationSupported": {
      "type": "boolean"
    },
    "canCancelOriginalWork": {
      "type": "boolean"
    },
    "canApply": {
      "type": "boolean"
    },
    "applySupported": {
      "type": "boolean"
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeDirectory": {
          "type": "string",
          "maxLength": 32768
        },
        "state": {
          "enum": ["missing", "empty", "initialized", "blocked"]
        },
        "environmentId": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "migrationIds": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projects": {
              "type": "integer",
              "minimum": 0
            },
            "threads": {
              "type": "integer",
              "minimum": 0
            },
            "messages": {
              "type": "integer",
              "minimum": 0
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            },
            "turnItems": {
              "type": "integer",
              "minimum": 0
            },
            "legacyEvents": {
              "type": "integer",
              "minimum": 0
            },
            "legacyThreads": {
              "type": "integer",
              "minimum": 0
            },
            "legacyMessages": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "projects",
            "threads",
            "messages",
            "runs",
            "turnItems",
            "legacyEvents",
            "legacyThreads",
            "legacyMessages"
          ]
        },
        "activeWork": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "providerInstances": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instanceId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "driver": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "configKeys": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 32768
                }
              },
              "environmentNames": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 32768
                }
              }
            },
            "required": ["instanceId", "driver", "configKeys", "environmentNames"]
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "present": {
                "type": "boolean"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "modifiedMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["present"]
          },
          "maxProperties": 16
        },
        "blockers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 32768
          }
        }
      },
      "required": [
        "homeDirectory",
        "state",
        "environmentId",
        "migrationIds",
        "counts",
        "activeWork",
        "providerInstances",
        "files",
        "blockers"
      ]
    },
    "lan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "homeDirectory": {
          "type": "string",
          "maxLength": 32768
        },
        "state": {
          "enum": ["missing", "empty", "initialized", "blocked"]
        },
        "environmentId": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "migrationIds": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projects": {
              "type": "integer",
              "minimum": 0
            },
            "threads": {
              "type": "integer",
              "minimum": 0
            },
            "messages": {
              "type": "integer",
              "minimum": 0
            },
            "runs": {
              "type": "integer",
              "minimum": 0
            },
            "turnItems": {
              "type": "integer",
              "minimum": 0
            },
            "legacyEvents": {
              "type": "integer",
              "minimum": 0
            },
            "legacyThreads": {
              "type": "integer",
              "minimum": 0
            },
            "legacyMessages": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "projects",
            "threads",
            "messages",
            "runs",
            "turnItems",
            "legacyEvents",
            "legacyThreads",
            "legacyMessages"
          ]
        },
        "activeWork": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "providerInstances": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instanceId": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "driver": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
              },
              "configKeys": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 32768
                }
              },
              "environmentNames": {
                "type": "array",
                "maxItems": 256,
                "items": {
                  "type": "string",
                  "maxLength": 32768
                }
              }
            },
            "required": ["instanceId", "driver", "configKeys", "environmentNames"]
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "present": {
                "type": "boolean"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "modifiedMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["present"]
          },
          "maxProperties": 16
        },
        "blockers": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 32768
          }
        }
      },
      "required": [
        "homeDirectory",
        "state",
        "environmentId",
        "migrationIds",
        "counts",
        "activeWork",
        "providerInstances",
        "files",
        "blockers"
      ]
    },
    "electronProfiles": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "profileDirectory": {
            "type": "string",
            "maxLength": 32768
          },
          "localState": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "present": {
                "type": "boolean"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "modifiedMs": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": ["present"]
          }
        },
        "required": ["profileDirectory", "localState"]
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 32768
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 32768
      }
    },
    "preservePaths": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 32768
      }
    },
    "requirements": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 32768
      }
    },
    "adoptOriginalWithWorkSupported": {
      "type": "boolean"
    },
    "canAdoptOriginalWithWork": {
      "type": "boolean"
    },
    "importRetainedLanHistorySupported": {
      "type": "boolean"
    },
    "canImportRetainedLanHistory": {
      "type": "boolean"
    },
    "historyImportBlockers": {
      "maxItems": 256,
      "items": {
        "maxLength": 256,
        "type": "string"
      },
      "type": "array"
    },
    "historyImportPreview": {
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewGeneration",
        "sourceEnvironmentId",
        "targetEnvironmentId",
        "sourceHistoryGeneration",
        "targetHistoryGeneration",
        "summary",
        "blockers",
        "providerMappings",
        "baseline"
      ],
      "properties": {
        "providerMappings": {
          "maxItems": 1024,
          "items": {
            "additionalProperties": false,
            "required": ["sourceInstanceId", "driver", "targetInstanceId", "targetCandidates"],
            "properties": {
              "driver": {
                "maxLength": 256,
                "type": "string"
              },
              "targetCandidates": {
                "maxItems": 1024,
                "items": {
                  "maxLength": 256,
                  "type": "string"
                },
                "type": "array"
              },
              "targetInstanceId": {
                "maxLength": 256,
                "type": ["string", "null"]
              },
              "sourceInstanceId": {
                "maxLength": 256,
                "type": "string"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "additionalProperties": false,
          "required": [
            "sourceThreads",
            "eligibleThreads",
            "newThreads",
            "alreadyImportedThreads",
            "sourceMessages",
            "importMessages",
            "sourceCards",
            "importCards",
            "convertedCards",
            "attachments",
            "attachmentBytes",
            "missingAttachments"
          ],
          "properties": {
            "newThreads": {
              "minimum": 0,
              "type": "integer"
            },
            "missingAttachments": {
              "minimum": 0,
              "type": "integer"
            },
            "importMessages": {
              "minimum": 0,
              "type": "integer"
            },
            "convertedCards": {
              "minimum": 0,
              "type": "integer"
            },
            "attachments": {
              "minimum": 0,
              "type": "integer"
            },
            "eligibleThreads": {
              "minimum": 0,
              "type": "integer"
            },
            "alreadyImportedThreads": {
              "minimum": 0,
              "type": "integer"
            },
            "sourceMessages": {
              "minimum": 0,
              "type": "integer"
            },
            "sourceCards": {
              "minimum": 0,
              "type": "integer"
            },
            "attachmentBytes": {
              "minimum": 0,
              "type": "integer"
            },
            "sourceThreads": {
              "minimum": 0,
              "type": "integer"
            },
            "importCards": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "sourceHistoryGeneration": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "targetHistoryGeneration": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "sourceEnvironmentId": {
          "maxLength": 256,
          "type": "string"
        },
        "blockers": {
          "maxItems": 256,
          "items": {
            "maxLength": 256,
            "type": "string"
          },
          "type": "array"
        },
        "reviewGeneration": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "baseline": {
          "additionalProperties": false,
          "required": [
            "targetEventHead",
            "eventPrefixGeneration",
            "existingRowsGeneration",
            "existingWorkGeneration"
          ],
          "properties": {
            "existingWorkGeneration": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "eventPrefixGeneration": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            "targetEventHead": {
              "minimum": 0,
              "type": "integer"
            },
            "existingRowsGeneration": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "targetEnvironmentId": {
          "maxLength": 256,
          "type": "string"
        }
      },
      "type": ["object", "null"]
    },
    "historyImportRecovery": {
      "additionalProperties": false,
      "required": [
        "repairId",
        "phase",
        "receiptPath",
        "sourceEnvironmentId",
        "targetEnvironmentId",
        "reviewGeneration",
        "recoverSupported",
        "rollbackSupported"
      ],
      "properties": {
        "reviewGeneration": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "receiptPath": {
          "maxLength": 32768,
          "type": "string"
        },
        "targetEnvironmentId": {
          "maxLength": 256,
          "type": "string"
        },
        "repairId": {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        "phase": {
          "enum": [
            "backing-up",
            "staging",
            "publishing-attachments",
            "publishing-database",
            "published",
            "rolling-back",
            "completed",
            "rolled-back"
          ]
        },
        "sourceEnvironmentId": {
          "maxLength": 256,
          "type": "string"
        },
        "recoverSupported": {
          "type": "boolean"
        },
        "rollbackSupported": {
          "type": "boolean"
        }
      },
      "type": ["object", "null"]
    },
    "historyImportStorage": {
      "type": ["object", "null"],
      "required": ["requiredBytes", "availableBytes", "sufficient"],
      "properties": {
        "sufficient": {
          "type": "boolean"
        },
        "availableBytes": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "requiredBytes": {
          "type": "integer",
          "maximum": 9007199254740991,
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "operation",
    "planId",
    "state",
    "recommendedAction",
    "canApply",
    "applySupported",
    "original",
    "lan",
    "electronProfiles",
    "conflicts",
    "blockers",
    "preservePaths",
    "requirements"
  ]
}
